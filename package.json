{
  "name": "codequest",
  "version": "0.1.0",
  "private": true,
  "description": "CodeQuest - learn C++ and competitive programming through bite-sized interactive lessons.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:seed && tsx scripts/seed-problems-lite.ts && tsx scripts/normalize-problem-tags.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "content:verify": "tsx scripts/verify-content.ts",
    "db:seed:problems": "tsx scripts/seed-problems.ts",
    "problems:verify": "tsx scripts/verify-problems.ts",
    "contest:create": "tsx scripts/create-contest.ts",
    "db:seed:contests": "tsx scripts/seed-contests.ts",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.56.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.18"
  }
}
