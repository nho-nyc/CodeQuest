# ---------------------------------------------------------------
# CodeQuest environment variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Local dev example (matches the commands in README):
DATABASE_URL="postgresql://codequest:CHANGE_ME@localhost:5432/codequest"

# Set to "true" when the database requires TLS (Supabase, Neon, RDS...).
DATABASE_SSL="false"

# Public origin of the app (used for absolute URLs and secure cookies).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Code judge (Judge0). Without JUDGE0_URL, Run/Submit report "judge unavailable" (nothing is faked).
# Self-hosted Judge0 CE:   JUDGE0_URL="https://judge0.example.com"  (+ JUDGE0_AUTH_TOKEN if you enabled auth)
# RapidAPI-hosted Judge0:  JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
#                          JUDGE0_RAPIDAPI_KEY="..." JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"
# Language ids differ between Judge0 versions; check GET /languages on your instance.
# JUDGE0_URL=""
# JUDGE0_AUTH_TOKEN=""
# JUDGE0_RAPIDAPI_KEY=""
# JUDGE0_RAPIDAPI_HOST=""
# JUDGE0_CPP17_ID="54"
# JUDGE0_CPP20_ID="105"

# Not used yet (reserved for later phases):
# Redis for rate limiting / caching (Phase 3+)
# REDIS_URL=""
# Google OAuth (not implemented in MVP)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Shared rate limiting for the judge-backed endpoints (repair + practice Run/Submit). OPTIONAL.
# Without these the limits are per serverless instance (the effective ceiling is the limit times the number of warm instances).
# With an Upstash Redis REST database, one atomic counter is shared by every instance. Names only: keep the values secret.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional extra key material for the signed Repair Workshop progress cookie (hints taken, reveal unlock).
# REPAIR_PROGRESS_SECRET=
